{
  "name": "@local/dsh-custom-background_by_nagisa",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Custom gradient or image background for the DSH Web GUI, with Apple-style materials and a Settings row.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
